# SITE_ADDRESS 填域名（如 intel.example.com）即自动申请 HTTPS 证书；未设置时仅监听 :80。
{$SITE_ADDRESS}

encode zstd gzip

header {
	X-Content-Type-Options nosniff
	X-Frame-Options DENY
	Referrer-Policy strict-origin-when-cross-origin
	-Server
}

# 公开接口（REST v1、MCP、RSS、llms.txt）也由后端直接提供
@backend path /api/* /health /feed.xml /feed/* /llms.txt
handle @backend {
	reverse_proxy api:8000
}

handle {
	reverse_proxy web:3000
}
