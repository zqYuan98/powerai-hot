# 复制为 deploy/.env 后填写。所有密钥只放这里，不要提交到仓库。

# ---------- 访问 ----------
# 域名（自动申请 HTTPS）；暂无域名时填 :80
SITE_ADDRESS=intel.example.com
# 登录口令，至少 12 位
APP_PASSWORD=
# 会话签名密钥：openssl rand -base64 48 | tr '+/' '-_'
SESSION_SECRET=
# 使用 HTTPS 时为 true；只用 :80 访问时改为 false
COOKIE_SECURE=true
# 推送消息里的站内链接前缀
PUBLIC_BASE_URL=https://intel.example.com
# 对外端口（默认 80/443）。本机已有服务占用时改为如 127.0.0.1:18090 / 127.0.0.1:18443
HTTP_BIND=80
HTTPS_BIND=443

# ---------- 数据库 ----------
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------- LLM（任意 OpenAI 兼容端点，默认 DeepSeek）----------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 初筛与精读用 fast（关闭推理，约 3 秒/条）；日报导语、事件综述用 pro（低强度推理）。
# deepseek-chat 已下线；deepseek-v4-flash 已更名 deepseek-flash。
LLM_MODEL_FAST=deepseek-flash
LLM_MODEL_PRO=deepseek-v4-pro
# 使用非 DeepSeek 的 OpenAI 兼容服务、且对方不认 thinking/reasoning_effort 参数时改为 false
LLM_THINKING_CONTROL=true
# 每百万 token 单价（元，[输入, 输出]，按高峰价换算），仅用于用量页估算费用
LLM_PRICES={"deepseek-flash":[2.1,8.5],"deepseek-v4-pro":[9.4,28.1]}

# ---------- Embedding（可选：事件归并、语义搜索）----------
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 推送（可选）----------
FEISHU_WEBHOOK_URL=

# ---------- 构建镜像源（国内服务器建议保留）----------
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
NPM_REGISTRY=https://registry.npmmirror.com

# ---------- 备份 ----------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
