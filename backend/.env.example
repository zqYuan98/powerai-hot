# 复制为 .env 后按需修改。密钥不得提交到仓库。
DEBUG=true
CORS_ORIGINS=["http://localhost:3010","http://127.0.0.1:3010"]

# 鉴权（生产必填；本地启动脚本在缺失时生成临时值）
WORKSPACE_TOKEN=
ADMIN_TOKEN=
SESSION_SECRET=
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
APP_ORIGIN=https://portal.example.com
WORKSPACE_NAME=电力 AI 情报工作空间
WORKSPACE_SUBTITLE=内部情报与知识服务

# 可信代理 IP/CIDR，逗号分隔。直连/本地留空；Compose 会覆盖为固定 nginx 地址。
TRUSTED_PROXY_CIDRS=

# 本地默认 SQLite；生产在 /opt/e-ai/secrets/backend.env 中使用独立凭据的 PostgreSQL。
DATABASE_URL=sqlite:///./powerai_hot.db
# DATABASE_URL=postgresql+psycopg://powerai:${POSTGRES_PASSWORD}@db:5432/powerai_hot

# AI 分析：deepseek（默认）| custom（OpenAI 兼容自定义端点）| ollama
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_PREFILTER_MODEL=deepseek-chat
DEEPSEEK_SCORER_MODEL=deepseek-chat
DEEPSEEK_WRITER_MODEL=deepseek-chat
# 自定义模型：任何 OpenAI 兼容 /chat/completions 服务（第三方云或私有化 vLLM 等）。
# CUSTOM_API_URL 可填基地址（https://api.example.com/v1）或完整 chat/completions 地址；
# CUSTOM_API_KEY 私有化部署可留空。
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# 可选向量服务
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# 采集与推送。生产默认由 systemd timer 调用 python -m jobs.*，Web 进程不自动采集。
AUTO_CRAWL_ENABLED=false
CRAWL_INTERVAL_HOURS=2
CRAWL_MIN_GAP_SECONDS=300
HF_ENDPOINT=https://huggingface.co
FEISHU_WEBHOOK_URL=

# 不要创建 NEXT_PUBLIC_ADMIN_TOKEN。NEXT_PUBLIC_* 会暴露给浏览器。
